# Copy to .env and adjust. Never commit .env.

# ---------------------------------------------------------------- MLflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT=bl_brand_ranking
REGISTERED_MODEL_NAME=bl_brand_ranker

# ------------------------------------------------------------------ data
RAW_CSV_PATH=Task/bl_full_data.csv
DELTA_TABLE_PATH=data/delta/bl_sessions

# --------------------------------------------------------------- serving
SERVING_PORT=8000
TORCH_NUM_THREADS=2
# Size of TabPFN's internal ensemble. 8 = library default = the researcher's implicit
# setting. Lowering it trades ranking fidelity for latency -- see README section 6.
TABPFN_N_ESTIMATORS=8

# ------------------------------------------------------------- scheduler
SCHEDULE_CRON=0 5 * * 0
SCHEDULE_TIMEZONE=UTC

# ----------------------------------------------------------------- TabPFN
# Leave unset to use the local open-source weights (no network, no token).
# Set to true ONLY to reproduce the researcher's hosted-API behaviour.
# USE_HOSTED_TABPFN=false
# TABPFN_TOKEN=

# ------------------------------------------------------------ Databricks
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=
# MLFLOW_REGISTRY_URI=databricks-uc
# DELTA_TABLE_URI=main.bl.bl_sessions
